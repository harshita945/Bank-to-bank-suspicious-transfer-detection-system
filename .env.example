# ==============================================================
# Bank-to-Bank Suspicious Transaction Detection System
# Environment Configuration Template
# ==============================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32bytes

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bank_detection_db

# Suspicious Activity Detection Thresholds
# Amounts in INR / Demo Currency units
HIGH_AMOUNT_THRESHOLD=200000.00
VELOCITY_WINDOW_MINUTES=15
VELOCITY_COUNT_THRESHOLD=3
STRUCTURING_LOWER_BOUND=45000.00
STRUCTURING_UPPER_BOUND=49999.00
RAPID_FORWARD_WINDOW_MINUTES=60
CIRCULAR_DEPTH_LIMIT=5
SIMILAR_AMOUNT_TOLERANCE_PCT=2.0
